/// Utilities for networking, like URL parsing.
@ModuleInfo { minPklVersion = "0.34.0" }
@Since { version = "0.33.0" }
module pkl.net

/// Constructs a Url as described by [input], following
/// [RFC 3986](https://www.rfc-editor.org/rfc/rfc3986).
/// Accepts a URL reference (one without a scheme).
///
/// This is lenient: whatever a component cannot hold literally is percent-encoded, and whatever is
/// already percent-encoded is kept as is.
///
/// Throws if [input] is not a valid URL.
///
/// To test if [input] is a valid URL, use [String.isValidUrl].
///
/// Facts:
/// ```
/// net.Url("https://example.com/foo?a=1").host == "example.com"
/// net.Url("https://example.com/foo?a=1").query == "a=1"
/// net.Url("https://example.com/a b").rawPath == "/a%20b"
/// net.Url("/foo").scheme == null
/// ```
external const function Url(input: String): Url

/// A URL, as defined by [RFC 3986](https://www.rfc-editor.org/rfc/rfc3986).
/// [RFC 6874](https://www.rfc-editor.org/rfc/rfc6874) IPv6 zone literals are also supported.
///
/// Every component is held percent-encoded, in its `raw` property, such as [rawPath]:
/// [Url()] encodes whatever a component cannot hold literally, and a component that is set by hand,
/// or amended, has to be encoded already.
/// The percent-decoded form of each component is available without the `raw` prefix, such as
/// [path].
///
/// Facts:
/// ```
/// net.Url("https://example.com/a b").rawPath == "/a%20b"
/// net.Url("https://example.com/a b").path == "/a b"
/// net.Url("https://example.com/a%20b").rawPath == "/a%20b"
/// ```
class Url {
  /// The scheme, without the trailing `:`, or [null] if this is a relative reference.
  scheme: String(isValidScheme(this))?

  /// The percent-encoded userinfo, without the trailing `@`, or [null] if this URL has none.
  ///
  /// Only a URL with a [rawHost] can have userinfo.
  rawUserInfo: String(rawHost != null, isValidUserInfo(this))?

  /// The percent-decoded [rawUserInfo].
  hidden fixed userInfo: String? =
    if (rawUserInfo != null) decodeUrlComponent(rawUserInfo) else null

  /// The percent-encoded host, or [null] if this URL has no authority.
  ///
  /// A [null] host is not the same as an empty one: `file:/tmp` has no host, `file:///tmp` has an
  /// empty one.
  ///
  /// An IPv6 address must be enclosed in brackets, as in `[::1]`.
  /// It may carry a zone identifier, as described in RFC 6874.
  /// Anything else is a registered name, which cannot contain `[`, `]` or `:` literally.
  rawHost: String(isValidHost(this))?

  /// The percent-decoded [rawHost].
  hidden fixed host: String? = if (rawHost != null) decodeUrlComponent(rawHost) else null

  /// The port, without the leading `:`, or [null] if this URL states none.
  ///
  /// Only a URL with a [rawHost] can have a port.
  rawPort: String(rawHost != null, matches(Regex(#"\d*"#)))?

  /// The number that [rawPort] states.
  ///
  /// This is [null] if [rawPort] is [null], or if [rawPort] is not parseable as a [UInt16].
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com:8080/").port == 8080
  /// net.Url("https://example.com:/").port == null
  /// ```
  hidden fixed port: UInt16? =
    let (parsed = rawPort?.toIntOrNull())
      if (parsed is UInt16) parsed else null

  /// The percent-encoded path, or the empty string if this URL has none.
  ///
  /// With a [rawHost], the path is empty or starts with `/`.
  /// Without one, it may be *rootless*, as in `mailto:user@example.com`.
  /// Without a [scheme], its first segment cannot contain `:`.
  ///
  /// To change the path without encoding it first, use [resolve()], which is as lenient as [Url()].
  /// Unlike amending, this drops [rawQuery] and [rawFragment].
  rawPath: String(isValidPath(this, scheme != null, rawHost != null)) = ""

  /// The percent-decoded [rawPath].
  ///
  /// An encoded `/` is decoded like any other octet, so it cannot be distinguished from a `/` that
  /// separates segments.
  /// [pathSegments] disambiguates between separator and literal `/` characters.
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/a%2Fb/c").path == "/a/b/c"
  /// net.Url("https://example.com/a%2Fb/c").pathSegments == List("a/b", "c")
  /// ```
  hidden fixed path: String = decodeUrlComponent(rawPath)

  /// The percent-encoded query, without the leading `?`, or [null] if this URL has none.
  ///
  /// The empty string is a URL ending in a bare `?`.
  rawQuery: String(isValidQuery(this))?

  /// The percent-decoded [rawQuery].
  ///
  /// Unlike [queryParameters], this does not read [rawQuery] as
  /// `application/x-www-form-urlencoded`, so a `+` is kept as is.
  hidden fixed query: String? = if (rawQuery != null) decodeUrlComponent(rawQuery) else null

  /// The percent-encoded fragment, without the leading `#`, or [null] if this URL has none.
  ///
  /// The empty string is a URL ending in a bare `#`.
  rawFragment: String(isValidFragment(this))?

  /// The percent-decoded [rawFragment].
  hidden fixed fragment: String? =
    if (rawFragment != null) decodeUrlComponent(rawFragment) else null

  /// The serialization of this URL.
  fixed stringValue: String = toString()

  /// Tells if this URL is absolute, that is, has a non-null scheme.
  hidden fixed isAbsolute: Boolean = scheme != null

  /// Tells if this URL's path is absolute, that is, starts with `/`.
  hidden fixed hasAbsolutePath: Boolean = rawPath.startsWith("/")

  /// The authority, without the leading `//`, or [null] if this URL has none.
  ///
  /// A URL has an authority exactly when it has a [rawHost].
  /// This is [rawUserInfo], [rawHost] and [rawPort] joined back together.
  external fixed authority: String?

  /// What [rawHost] is, or [null] if this URL has no authority.
  ///
  /// - `"ipv6"`: an IPv6 address, such as `[::1]`
  /// - `"ipvFuture"`: an IP address of a version that RFC 3986 leaves for the future
  /// - `"ipv4"`: an IPv4 address in dotted-decimal form, such as `192.0.2.1`
  /// - `"name"`: any other host, a *registered name*
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/").hostKind == "name"
  /// net.Url("https://192.0.2.1/").hostKind == "ipv4"
  /// net.Url("https://[::1]/").hostKind == "ipv6"
  /// net.Url("/foo").hostKind == null
  /// ```
  external fixed hostKind: ("name" | "ipv4" | "ipv6" | "ipvFuture")?

  /// The percent-decoded zone identifier of an IPv6 [rawHost], as described in RFC 6874, or [null]
  /// if it states none.
  ///
  /// Facts:
  /// ```
  /// net.Url("http://[fe80::1%25eth0]/").zoneId == "eth0"
  /// net.Url("http://[fe80::1]/").zoneId == null
  /// ```
  external fixed zoneId: String?

  /// The percent-decoded segments of [rawPath].
  ///
  /// [pathSegments] does not tell if the path is absolute or not.
  /// A relative URL reference `"a/b"` also has path segments `List("a", "b")`.
  /// To disambiguate between the two, use [hasAbsolutePath].
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/a/b%20c").pathSegments == List("a", "b c")
  /// net.Url("https://example.com/a/b%2Fc").pathSegments == List("a", "b/c")
  /// ```
  external fixed pathSegments: List<String>

  /// The percent-decoded parameters of [rawQuery], or [null] if this URL has no query.
  ///
  /// [rawQuery] is read as `application/x-www-form-urlencoded`.
  /// A name that repeats holds the values of all its occurrences, in the order they are written.
  /// A parameter that states no `=` holds no value at all, and is left out; this is not the same as
  /// a bare `=`, which gives it the empty string.
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/?q=a+b&q=c").queryParameters["q"] == new Listing { "a b"; "c" }
  /// net.Url("https://example.com/?").queryParameters.isEmpty
  /// net.Url("https://example.com/").queryParameters == null
  /// ```
  external fixed queryParameters: Mapping<String, Listing<String>>?

  /// Resolves [ref] against this URL.
  ///
  /// [ref] is either a relative reference, which is resolved against this URL, or an absolute URL,
  /// which replaces it entirely.
  /// Dot segments (`./` and `../`) are removed from the result's path, normalizing it.
  ///
  /// Throws if [ref] is a string that cannot be parsed, or if this URL is itself a relative
  /// reference.
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/a/b").resolve("../c").toString() == "https://example.com/c"
  /// net.Url("https://example.com/a/b").resolve("#top").toString() == "https://example.com/a/b#top"
  /// net.Url("foo:/a").resolve("..//x").toString() == "foo:/.//x"
  /// ```
  external function resolve(ref: String | Url): Url

  /// The normalized version of this URL, following *syntax-based normalization* as described in
  /// [section 6.2.2](https://www.rfc-editor.org/info/rfc3986/#section-6.2.2) of RFC 3986.
  ///
  /// [scheme] and [rawHost] are lowercased, as they are case-insensitive.
  /// Percent-encoding is normalized: an octet standing for an unreserved character is decoded, and
  /// any other octet is kept, with its hex digits uppercased.
  ///
  /// Dot segments (`./` and `../`) are only removed from an absolute [rawPath].
  /// A URL with a [rawHost] and no path is given the path `/`, which names the same resource.
  ///
  /// Does not perform normalization that requires knowing the scheme, such as removing a default
  /// port (see [section 6.2.3](https://www.rfc-editor.org/info/rfc3986/#section-6.2.3)).
  ///
  /// Facts:
  /// ```
  /// net.Url("HTTPS://Example.com/%7Euser").normalized == net.Url("https://example.com/~user")
  /// net.Url("https://example.com/a/b/../c").normalized.rawPath == "/a/c"
  /// net.Url("https://example.com").normalized.rawPath == "/"
  /// ```
  external hidden fixed normalized: Url

  /// Tells if this URL is equal to [other] according to *syntax-based normalization* as
  /// described in [section 6.2.2](https://www.rfc-editor.org/info/rfc3986/#section-6.2.2) of
  /// RFC 3986.
  ///
  /// Returns [true] if the [normalized] versions of [this] and [other] are the
  /// same, and [false] otherwise.
  ///
  /// Facts:
  /// ```
  /// net.Url("HTTPS://Example.com/%7Euser").equals(net.Url("https://example.com/~user"))
  /// !(net.Url("https://example.com/a%2Fb").equals(net.Url("https://example.com/a/b")))
  /// !(net.Url("https://example.com:443/").equals(net.Url("https://example.com/")))
  /// ```
  external function equals(other: Url): Boolean

  /// The serialization of this URL.
  ///
  /// Facts:
  /// ```
  /// net.Url("https://example.com/a b").toString() == "https://example.com/a%20b"
  /// net.Url("https://example.com/é").toString() == "https://example.com/%C3%A9"
  /// net.Url("HTTPS://example.com").toString() == "HTTPS://example.com"
  /// ```
  external function toString(): String

  /// Tells if [value] is a percent-encoded `userinfo`.
  external function isValidUserInfo(value: String): Boolean

  /// Tells if [value] is a `scheme`.
  external function isValidScheme(value: String): Boolean

  /// Tells if [value] is a percent-encoded `host`.
  external function isValidHost(value: String): Boolean

  /// Tells if [value] is a percent-encoded path that can sit next to a scheme and an authority, or,
  /// when [hasScheme] or [hasAuthority] is [false], next to no scheme or no authority.
  external function isValidPath(value: String, hasScheme: Boolean, hasAuthority: Boolean): Boolean

  /// Tells if [value] is a percent-encoded `query`.
  external function isValidQuery(value: String): Boolean

  /// Tells if [value] is a percent-encoded `fragment`.
  external function isValidFragment(value: String): Boolean
}

/// Percent-encodes [value] so that it can be interpolated into any URL component.
///
/// Every character other than an ASCII alphanumeric or one of `-._~`, the *unreserved* characters
/// of RFC 3986, is percent-encoded as its UTF-8 bytes.
///
/// Facts:
/// ```
/// net.encodeUrlComponent("a b&c") == "a%20b%26c"
/// net.encodeUrlComponent("50%") == "50%25"
/// ```
external const function encodeUrlComponent(value: String): String

/// Percent-decodes [value], interpreting the decoded bytes as UTF-8.
///
/// Throws if any `%` in [value] does not begin a percent-encoded octet.
/// To write a literal `%`, encode it as `%25`.
///
/// Facts:
/// ```
/// net.decodeUrlComponent("a%20b%26c") == "a b&c"
/// net.decodeUrlComponent("50%25") == "50%"
/// ```
external const function decodeUrlComponent(value: String): String

/// Builds a query from [parameters], for use as a [Url.rawQuery].
///
/// The result is `application/x-www-form-urlencoded`.
/// A name is written once per value it holds; one that holds no values is left out entirely.
///
/// [Url.queryParameters] reads back exactly the parameters given here, less any name that holds no
/// values.
///
/// Facts:
/// ```
/// net.buildQuery(new Mapping { ["q"] = new Listing { "a b" } }) == "q=a+b"
/// net.buildQuery(new Mapping { ["a"] = new Listing { "1"; "2" } }) == "a=1&a=2"
/// net.buildQuery(new Mapping { ["a"] = new Listing { "1" }; ["b"] = new Listing {} }) == "a=1"
/// ```
external const function buildQuery(parameters: Mapping<String, Listing<String>>): String

/// Reads [query] back into its parameters.
///
/// [query] is read as `application/x-www-form-urlencoded`.
/// A name that repeats holds the values of all its occurrences, in the order they are written.
/// A parameter that states no `=` holds no value at all, and is left out.
///
/// Throws if any `%` in [query] does not begin a percent-encoded octet.
///
/// Facts:
/// ```
/// net.parseQuery("a=1&a=2") == new Mapping { ["a"] = new Listing { "1"; "2" } }
/// net.parseQuery("q=a+b&bare") == new Mapping { ["q"] = new Listing { "a b" } }
/// ```
external const function parseQuery(query: String): Mapping<String, Listing<String>>

// language=RegExp
local const hex: String = "[0-9a-fA-F]"

// language=RegExp
local const decByte: String = #"(25[0-5]|2[0-4][0-9]|[01]?[0-9]{1,2})"#

local const ipv4String = #"(\#(decByte)\.){3}\#(decByte)"#

local const ipv6String =
  #"""
  (?x:
  (\#(hex){1,4}:){7}\#(hex){1,4}           # x:x:x:x:x:x:x:x
  | (\#(hex){1,4}:){1,7}:                    # x:: … x:x:x:x:x:x:x::
  | (\#(hex){1,4}:){6}:\#(hex){1,4}          # x:x:x:x:x:x::x
  | (\#(hex){1,4}:){5}(:\#(hex){1,4}){1,2}   # x:x:x:x:x::x … x:x:x:x:x::x:x
  | (\#(hex){1,4}:){4}(:\#(hex){1,4}){1,3}   # x:x:x:x::x … x:x:x:x::x:x:x
  | (\#(hex){1,4}:){3}(:\#(hex){1,4}){1,4}   # x:x:x::x … x:x:x::x:x:x:x
  | (\#(hex){1,4}:){2}(:\#(hex){1,4}){1,5}   # x:x::x … x:x::x:x:x:x:x
  | \#(hex){1,4}:(:\#(hex){1,4}){1,6}        # x::x … x::x:x:x:x:x:x
  | :((:\#(hex){1,4}){1,7}|:)                # ::x … ::x:x:x:x:x:x:x, ::
  | (?: # IPv6 with trailing IPv4
  (\#(hex){1,4}:){6}                      # x:x:x:x:x:x:
  | (\#(hex){1,4}:){5}:                     # x:x:x:x:x::
  | (\#(hex){1,4}:){4}(:\#(hex){1,4})?:     # x:x:x:x:: … x:x:x:x::x:
  | (\#(hex){1,4}:){3}(:\#(hex){1,4}){0,2}: # x:x:x:: … x:x:x::x:x:
  | (\#(hex){1,4}:){2}(:\#(hex){1,4}){0,3}: # x:x:: … x:x::x:x:x:
  | \#(hex){1,4}:(:\#(hex){1,4}){0,4}:      # x:: … x::x:x:x:x:
  | :(:\#(hex){1,4}){0,5}:                  # :: … ::x:x:x:x:x:
  )\#(ipv4String)                           # …d.d.d.d
  | \#(nonGlobalIpv6String)%[^%]+ # Scoped address
  )
  """#

// language=RegExp
local const nonGlobalIpv6String =
  #"""
  (?xi-U:
  ff[0-9a-f][0-9a-d](?:                    # multicast (FF00::/8 with "scop" less than E (global scope))
  (:[0-9a-f]{1,4}){7}                        # FFxx:x:x:x:x:x:x:x
  | :(:|(:[0-9a-f]{1,4}){1,6})               # FFxx:: … FFxx::x:x:x:x:x:x
  | :[0-9a-f]:(:|(:[0-9a-f]{1,4}){1,5})      # FFxx:x:: … FFxx:x::x:x:x:x:x
  | (:[0-9a-f]){2}:(:|(:[0-9a-f]{1,4}){1,4}) # FFxx:x:x:: … FFxx:x:x::x:x:x:x
  | (:[0-9a-f]){3}:(:|(:[0-9a-f]{1,4}){1,3}) # FFxx:x:x:x:: … FFxx:x:x:x::x:x:x
  | (:[0-9a-f]){4}:(:|(:[0-9a-f]{1,4}){1,2}) # FFxx:x:x:x:x:: … FFxx:x:x:x:x::x:x
  | (:[0-9a-f]){5}:(:|(:[0-9a-f]{1,4}))      # FFxx:x:x:x:x:x:: … FFxx:x:x:x:x:x::x
  | (:[0-9a-f]){6}::                         # FFxx:x:x:x:x:x:x::
  )
  | fe80(?:                                # link-local unicast (FE80::/10)
  (:0{1,4}){3}(?:                            # FE80:0:0:0…
  :: | :(:[0-9a-f]{1,4}){1,3}                # FE80:0:0:0:: … FE80:0:0:0::x:x:x
  | :[0-9a-f]{1,4}:(:|(:[0-9a-f]{1,4}){1,2}) # FE80:0:0:0:x:: … FE80:0:0:0:x::x:x
  | (:[0-9a-f]{1,4}){2}::([0-9a-f]{1,4})?    # FE80:0:0:0:x:x:: … FE80:0:0:0:x:x::x
  | (:[0-9a-f]{1,4}){3}:(:|[0-9a-f]{1,4})    # FE80:0:0:0:x:x:x::, FE80:0:0:0:x:x:x:x
  )
  | (:0{1,4}){0,2}:(:|(:[0-9a-f]{1,4}){1,4})  # FE80:: … FE80:0:0::x:x:x:x
  )
  )
  """#

/// A string that contains either an IPv4 or IPv6 address.
@Since { version = "0.34.0" }
typealias IpAddressString = Ipv4AddressString | Ipv6AddressString

/// A string that contains either an IPv4 or IPv6 address and port.
@Since { version = "0.34.0" }
typealias IpAddressPortString = Ipv4AddressPortString | Ipv6AddressPortString

/// A string that contains either an IPv4 or IPv6 CIDR range.
@Since { version = "0.34.0" }
typealias IpCidrString = Ipv4CidrString | Ipv6CidrString

/// A string that contains either a IPv4 of IPv6 network.
@Since { version = "0.34.0" }
typealias IpNetworkString = Ipv4NetworkString | Ipv6NetworkString

/// A string that contains an IPv4 address.
@Since { version = "0.34.0" }
typealias Ipv4AddressString = String(matches(Regex(ipv4String)))

/// A string that contains an IPv6 address.
///
/// IPv6 unicast and multicast addresses of non-global scope except for the unspecified address and the loopback address
/// may include a scope ID suffix, e.g. `"fe80::1234%1"`.
/// Site-local unicast addresses (`fec0::/10`) are deprecated and thus are considered to be global unicast addresses.
@Since { version = "0.34.0" }
typealias Ipv6AddressString = String(matches(Regex(ipv6String)))

/// A string that contains an IPv4 address and port.
@Since { version = "0.34.0" }
typealias Ipv4AddressPortString = String(matches(Regex(#"\#(ipv4String):[0-9]{1,5}"#)))

/// A string that contains an IPv6 address and port.
@Since { version = "0.34.0" }
typealias Ipv6AddressPortString = String(matches(Regex(#"\[\#(ipv6String)\]:[0-9]{1,5}"#)))

/// A string that contains an IPv4 network CIDR.
@Since { version = "0.34.0" }
typealias Ipv4CidrString = String(matches(Regex(#"\#(ipv4String)/([12]?[0-9]|3[012])"#)))

/// A string that contains an IPv6 network CIDR.
@Since { version = "0.34.0" }
typealias Ipv6CidrString =
  String(matches(Regex(#"\#(ipv6String)/([1-9]?[0-9]|1([01][0-9]|2[0-8]))"#)))

/// A string that contains a strict IPv4 network, i.e. an IPv4 CIDR block whose address has no bits set beyond its prefix.
///
/// For example, `"10.0.0.0/24"` qualifies, but `"10.0.0.1/24"` does not, since the latter has host bits set.
@Since { version = "0.34.0" }
typealias Ipv4NetworkString = Ipv4CidrString(baseIsFirstAddress)

/// A string that contains a strict IPv6 network, i.e. an IPv6 CIDR block whose address has no bits set beyond its prefix.
///
/// For example, `"2001:db8::/32"` qualifies, but `"2001:db8::1/32"` does not, since the latter has host bits set.
@Since { version = "0.34.0" }
typealias Ipv6NetworkString = Ipv6CidrString(baseIsFirstAddress)

local const baseIsFirstAddress: (IpCidrString) -> Boolean = (str: IpCidrString) ->
  let (net = IpNetwork(str)) net.base == net.firstAddress

/// Creates an [IpAddress] from an [IpAddressString].
@Since { version = "0.34.0" }
external const function IpAddress(ip: IpAddressString): IpAddress

/// An IP address.
@Since { version = "0.34.0" }
abstract external class IpAddress extends Any {
  /// The canonical string representation of the address.
  fixed stringValue: String = toString()

  /// The byte buffer representation of the address.
  ///
  /// The highest byte of the address is at index `0`.
  hidden bytes: Bytes

  /// Tells if this address is the unspecified address.
  hidden isUnspecified: Boolean

  /// Tells if this address is the loopback address.
  hidden isLoopback: Boolean

  /// The reverse DNS (PTR record) hostname for this address.
  hidden reverseDnsHostname: String

  abstract function add(n: Int): this

  /// Return a [List] of IP addresses between [this] and [other], inclusive.
  ///
  /// If [other] represents a lower address, an empty list is returned.
  abstract function rangeTo(other: this): List<this>

  abstract function toString(): IpAddressString
}

/// Creates an [Ipv4Address] from an [Ipv4AddressString].
@Since { version = "0.34.0" }
external const function Ipv4Address(ip: Ipv4AddressString): Ipv4Address

/// An IPv4 address, as defined by [RFC 791](https://www.rfc-editor.org/info/rfc791/).
///
/// Facts:
/// ```
/// net.Ipv4Address("127.0.0.1").stringValue == "127.0.0.1"
/// net.Ipv4Address("127.0.0.1").bytes == Bytes(0x7f, 0x00, 0x00, 0x01)
/// ```
@Since { version = "0.34.0" }
external class Ipv4Address extends IpAddress {
  /// The byte buffer representation of the address.
  ///
  /// The highest byte of the address is at index `0`.
  hidden bytes: Bytes(length == 4)

  /// Tells if this address is the unspecified address (`0.0.0.0`).
  hidden isUnspecified: Boolean

  /// Tells if this address is the loopback address (`127.x.x.x`).
  hidden isLoopback: Boolean

  /// The reverse DNS (PTR record) hostname for this address.
  hidden reverseDnsHostname: String

  /// Return the IP address [n] addresses higher than [this].
  ///
  /// Wraps on overflow.
  ///
  /// Facts:
  /// ```
  /// net.Ipv4Address("0.0.0.0").add(1) == net.Ipv4Address("0.0.0.1") 
  /// net.Ipv4Address("255.255.255.255").add(1) == net.Ipv4Address("0.0.0.0") 
  /// net.Ipv4Address("0.0.0.0").add(math.maxUInt32 + 1) == net.Ipv4Address("0.0.0.0") 
  /// ``` 
  external function add(n: Int): this

  /// Return a [List] of IPv4 addresses between [this] and [other], inclusive.
  ///
  /// If [other] represents a lower address, an empty list is returned.
  external function rangeTo(other: this): List<this>

  external function toString(): Ipv4AddressString
}

/// Creates an [Ipv6Address] from an [Ipv6AddressString].
@Since { version = "0.34.0" }
external const function Ipv6Address(ip: Ipv6AddressString): Ipv6Address

@Since { version = "0.34.0" }
external class Ipv6Address extends IpAddress {
  /// The byte buffer representation of the address.
  ///
  /// The highest byte of the address is at index `0`.
  hidden bytes: Bytes(length == 16)

  /// Tells if this address is the unspecified address (`::`).
  hidden isUnspecified: Boolean

  /// Tells if this address is the loopback address (`::1`).
  hidden isLoopback: Boolean

  /// The reverse DNS (PTR record) hostname for this address.
  hidden reverseDnsHostname: String

  /// Tells if this address is an IPv4-mapped address (`::ffff:0:0/96`).
  hidden isIpv4Mapped: Boolean

  /// Tells if this address is an IPv4-embedded address using the Well-Known Prefix (`64:ff9b::/96`)
  /// described by [RFC 6052 §2.1](https://tools.ietf.org/html/rfc6052#section-2.1).
  hidden isIpv4Embedded: Boolean

  /// The scope ID associated with this address, or [null] if the scope is unknown or not applicable.
  ///
  /// Only addresses of [non-global scope][isNonGlobalScope] are allowed to have a scope ID.
  hidden scopeId: String(isNonGlobalScope)?

  /// Tells if this address has non-global unicast or multicast scope.
  ///
  /// Returns [true] for link-local unicast and for multicast with "scop" field less than global.
  /// Returns [false] for the [unspecified address][isUnspecified] and the [loopback address][isLoopback],
  /// and for site-local addresses as per [RFC 4291 §2.5.7](https://tools.ietf.org/html/rfc4291#section-2.5.7).
  hidden isNonGlobalScope: Boolean

  /// Return the IP address [n] addresses higher than [this].
  ///
  /// Wraps on overflow.
  ///
  /// Facts:
  /// ```
  /// net.Ipv6Address("::").add(1) == net.Ipv6Address("::1") 
  /// net.Ipv6Address("ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff").add(1) == net.Ipv6Address("::") 
  /// ``` 
  external function add(n: Int): this

  /// Return a [List] of IPv6 addresses between [this] and [other], inclusive.
  ///
  /// If [other] represents a lower address, an empty list is returned.
  external function rangeTo(other: this): List<this>

  /// Returns a new [Ipv6Address] with the specified [scopeId]. 
  external function withScopeId(scopeId: String(isNonGlobalScope)?): this

  /// Returns the expanded string representation of this IPv6 address.
  ///
  /// In this representation:
  /// * Abbreviation of zeroes using `::` does not occur.
  /// * Each segment is zero-padded to 4 digits.
  ///
  /// As with [stringValue] and [toString()], if [isIpv4Mapped] or [isIpv4Embedded] are `true`,
  /// then the final 4 bytes are rendered as an IPv4 address.
  ///
  /// Facts:
  /// ```
  /// net.Ipv6Address("::").toExpandedString() == "0000:0000:0000:0000:0000:0000:0000:0000"
  /// net.Ipv6Address("::ffff:127.0.0.1").toExpandedString() == "0000:0000:0000:0000:0000:ffff:127.0.0.1"
  /// ```
  external function toExpandedString(): Ipv6AddressString

  /// Returns the canonical string representation of this IPv6 address.
  ///
  /// If [isIpv4Mapped] or [isIpv4Embedded] are `true`, then the final 4 bytes are rendered as an IPv4 address.
  ///
  /// Facts:
  /// ```
  /// net.Ipv6Address("0000::0:00:000").toString() == "::"
  /// net.Ipv6Address("0000::ffff:127.0.0.1").toString() == "::ffff:127.0.0.1"
  /// ```
  external function toString(): Ipv6AddressString
}

@Since { version = "0.34.0" }
external const function IpNetwork(cidr: IpCidrString): IpNetwork

@Since { version = "0.34.0" }
abstract external class IpNetwork extends Any {
  /// The base IP address of this network.
  base: IpAddress

  /// The CIDR prefix of this network.
  prefix: UInt

  /// The first IP address in this network.
  hidden firstAddress: IpAddress

  /// The last IP address in this network.
  hidden lastAddress: IpAddress

  /// The reverse DNS zone name for this network.
  ///
  /// This is [null] if [prefix] is smaller than the largest network representable as a reverse DNS zone.
  hidden reverseDnsZone: String?

  /// Returns [true] if [ip] is in this network.
  abstract function contains(ip: IpAddress): Boolean

  /// Return [true] if this network contains every IP in [other].
  abstract function containsNetwork(other: this): Boolean

  /// Return [true] if this network contains every IP in [other] or vice versa.
  abstract function overlaps(other: this): Boolean

  /// Returns all subnets of this network with prefix [targetPrefix].
  abstract function subdivideTo(targetPrefix: UInt): List<this>

  /// Returns the [n]th subnet of this network with prefix [targetPrefix].
  abstract function subnet(targetPrefix: UInt, n: UInt): this

  /// Returns the string representation of this network.
  ///
  /// Equivalent to `"\(base)/\(prefix)"`.
  abstract function toString(): IpCidrString
}

/// Creates an [Ipv4Network] from an [Ipv4CidrString].
@Since { version = "0.34.0" }
external const function Ipv4Network(ip: Ipv4CidrString): Ipv4Network

@Since { version = "0.34.0" }
external class Ipv4Network extends IpNetwork {
  /// The base IPv4 address of this network.
  base: Ipv4Address

  /// The CIDR prefix of this network.
  prefix: UInt(isBetween(0, bitWidth))

  local bitWidth = 32

  /// The first IPv4 address in this network.
  hidden firstAddress: Ipv4Address

  /// The last IPv4 address in this network.
  hidden lastAddress: Ipv4Address

  /// The subnet mask of this network.
  hidden subnetMask: Ipv4Address

  /// The reverse DNS zone name for this network as specified by [RFC 1035](https://www.rfc-editor.org/info/rfc1035/#section-3.5).
  ///
  /// This is [null] if [prefix] is smaller than the largest network representable as a reverse DNS zone.
  hidden reverseDnsZone: String?

  /// Returns [true] if [ip] is in this network.
  external function contains(ip: IpAddress): Boolean

  /// Return [true] if this network contains every IP in [other].
  external function containsNetwork(other: this): Boolean

  /// Return [true] if this network contains every IP in [other] or vice versa.
  external function overlaps(other: this): Boolean

  /// Returns all subnets of this network with prefix [targetPrefix].
  external function subdivideTo(
    targetPrefix: UInt(isBetween(0, bitWidth), this >= prefix),
  ): List<this>

  /// Returns the [n]th subnet of this network with prefix [targetPrefix].
  external function subnet(
    targetPrefix: UInt(isBetween(0, bitWidth), this >= prefix),
    n: UInt(this < 1.shl(targetPrefix - prefix)),
  ): this

  external function toString(): Ipv4CidrString
}

/// Creates an [Ipv6Network] from an [Ipv6CidrString].
@Since { version = "0.34.0" }
external const function Ipv6Network(ip: Ipv6CidrString): Ipv6Network

@Since { version = "0.34.0" }
external class Ipv6Network extends IpNetwork {
  /// The base IPv6 address of this network.
  base: Ipv6Address

  /// The CIDR prefix of this network.
  prefix: UInt(isBetween(0, bitWidth))

  local bitWidth = 128

  /// The first IPv6 address in this network.
  external hidden firstAddress: Ipv6Address

  /// The last IPv6 address in this network.
  external hidden lastAddress: Ipv6Address

  /// The reverse DNS zone name for this network as specified by [RFC 8501](https://www.rfc-editor.org/info/rfc8501/).
  ///
  /// This is [null] if [prefix] is smaller than the largest network representable as a reverse DNS zone.
  hidden reverseDnsZone: String?

  /// Returns [true] if [ip] is in this network.
  external function contains(ip: IpAddress): Boolean

  /// Return [true] if this network contains every IP in [other].
  external function containsNetwork(other: this): Boolean

  /// Return [true] if this network contains every IP in [other] or vice versa.
  external function overlaps(other: this): Boolean

  /// Returns all subnets of this network with prefix [targetPrefix].
  external function subdivideTo(
    targetPrefix: UInt(isBetween(0, bitWidth), this >= prefix),
  ): List<this>

  /// Returns the [n]th subnet of this network with prefix [targetPrefix].
  external function subnet(
    targetPrefix: UInt(isBetween(0, bitWidth), this >= prefix),
    n: UInt((targetPrefix - prefix < 64).implies(this < 1.shl(targetPrefix - prefix))),
  ): this

  external function toString(): Ipv6CidrString
}

/// A string that contains a MAC address
@Since { version = "0.34.0" }
typealias MacAddressString = String(matches(Regex(#"(\#(hex){1,2}[\.:-]){5}(\#(hex){1,2})"#)))

/// Creates an [MacAddress] from an [MacAddressString].
///
/// Accepts `:`, `.`, or `-` as octet separators.
@Since { version = "0.34.0" }
external const function MacAddress(mac: MacAddressString): MacAddress

/// A [MAC address](https://en.wikipedia.org/wiki/MAC_address) in the EUI-48 numbering space.
@Since { version = "0.34.0" }
external class MacAddress {
  /// The canonical string representation of the address.
  fixed stringValue: String = toString()

  /// The byte buffer representation of the address.
  ///
  /// The highest byte of the address is at index `0`.
  hidden bytes: Bytes(length == 6)

  /// Given a [base] IPv6 network, return the IPv6 address calculated by stateless address autoconfiguration (SLAAC)
  /// as specified by [RFC 4862](https://www.rfc-editor.org/info/rfc4862/).   
  external function toSlaacAddress(base: Ipv6Network(prefix >= 64)): Ipv6Address

  external function toString(): MacAddressString
}
