facts {
  ["span positions are 1-based"] {
    true
    true
  }
  ["end is exclusive"] {
    true
    true
    true
    true
  }
  ["a child's span is contained in its parent's"] {
    true
    true
  }
  ["nodes constructed from scratch have no span"] {
    true
  }
  ["a spanless constructed node still renders"] {
    true
  }
  ["parsing the same text from a string and a resource differs only in displayUri"] {
    true
    true
    true
    true
    true
  }
}
examples {
  ["span of a module parsed from a string"] {
    new {
      start {
        line = X
        column = 1
        displayUri = ""
      }
      end {
        line = X
        column = 2
        displayUri = ""
      }
      displayUri = ""
    }
  }
  ["span of a leaf parsed from a string"] {
    new {
      start {
        line = X
        column = 3
        displayUri = ""
      }
      end {
        line = X
        column = 14
        displayUri = ""
      }
      displayUri = ""
    }
  }
  ["span of a module parsed from a resource carries the resource URI"] {
    new {
      start {
        line = X
        column = 1
        displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
      }
      end {
        line = X
        column = 2
        displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
      }
      displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
    }
  }
  ["span of a leaf parsed from a resource carries the resource URI"] {
    new {
      start {
        line = X
        column = 3
        displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
      }
      end {
        line = X
        column = 14
        displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
      }
      displayUri = "file:///$snippetsDir/input-helper/syntax/spans/sample.pkl"
    }
  }
}
