examples {
  ["Ipv6Address.toExpandedString()"] {
    "fe80:0000:0000:0000:0000:0000:0000:0000"
    "fe80:0000:0000:0000:0000:0000:0000:0001"
    "0000:0000:0000:0000:0000:0000:0000:00aa"
    "0000:0000:0000:0000:0000:0000:0000:0000"
    "0000:0000:0000:0000:0000:0000:0000:0001"
    "2001:0db8:0000:0000:0000:0000:0000:0000"
    "fe80:0000:0000:0000:0000:0000:0000:0001%1"
    "fe80:0000:0000:0000:0000:0000:0000:0001%0"
  }
  ["Ipv6Address.toExpandedString() with scoped addresses"] {
    "fe80:0000:0000:0000:0000:0000:0000:0000%1"
    "fe80:0000:0000:0000:0000:0000:0000:0000%0"
    "fe80:0000:0000:0000:0005:0006:0007:0008%1"
    "fe80:0000:0000:0000:0000:0000:0000:0000%000"
    "fe80:0000:0000:0000:0000:0000:0000:0000%001"
  }
  ["Ipv6Address.toExpandedString() with Ipv4 suffix"] {
    "ffff:ffff:ffff:ffff:0000:0000:ffff:ffff"
    "0000:0000:0000:0000:0000:0000:0102:0304"
    "2001:0db8:0000:0000:0000:0000:0102:0304"
    "000a:000b:000c:000d:000e:000f:0100:1e00"
    "0000:0000:0000:0000:0000:ffff:127.0.0.1"
    "0064:ff9b:0000:0000:0000:0000:127.0.0.1"
  }
  ["Ipv6Address.toString() compression"] {
    "1:2:3:4:5:6:7:8"
    "fe80::1:0:0:1"
    "fe80::1:0:0:1"
    "1:2:3:4::6:7:8"
    "1:2:3:4::6:7:8"
    "::"
    "::"
    "fe80::a:b:c:d:e:f"
    "2001:0:0:1::1"
    "2001:db8::1:0:0:1"
  }
  ["Ipv6Address.toString() compression with scoped addresses"] {
    "fe80::5:6:7:8%0"
    "fe80::1:0%0"
    "fe80::%0"
    "fe80::%1"
    "fe80::%000"
    "fe80::%001"
  }
  ["Ipv6Address.toString() compression with Ipv4 suffix"] {
    "::ffff:1.2.3.4"
    "::ffff:1.20.0.4"
    "fe80::102:304"
    "fe80::"
    "::"
  }
  ["Ipv6Address.toString()"] {
    "fe80::1"
    "101:1001:1010:110:100:1000:1100:1110"
    "::"
    "::1"
    "fe80::"
    "fe80::1:0"
    "::ffff:127.0.0.1"
    "64:ff9b::192.0.2.33"
    "2001:db8:122:344::c000:221"
    "fe80::1%1"
    "ff11::1%02"
    "fe80::%0"
  }
}
