open class Foo {
  @Deprecated
  open function bar() = 40

  @Deprecated { message="Use only Foo#qux" }
  open function baz() = "baz"

  open function qux() = 0
}

class Bar extends Foo {
  override function bar() = super.bar() + 2
  override function baz() = super.baz() + " was called"
  override function qux() = super.qux() - 1
}

barCall = new Bar {}.bar()
bazCall = new Bar {}.baz()
quxCall = new Bar {}.qux()

barCall2ShouldNotWarn = new Bar {}.bar()
bazCall2ShouldNotWarn = new Bar {}.baz()
