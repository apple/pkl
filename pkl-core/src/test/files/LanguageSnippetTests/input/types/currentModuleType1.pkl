res6: List<module> = fun(this)

res6a: module = res6[0]

function fun(m: module): List<module> = List((m) { x = 2 })

class Person

output {
  // force eval but don't render to prevent recursion
  value =
    let (r1 = res1)
    let (r2 = res2)
    let (r3 = res3)
    let (r4 = res4)
    let (r5 = res5)
    let (r6 = res6)
