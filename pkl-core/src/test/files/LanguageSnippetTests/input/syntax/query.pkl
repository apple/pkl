amends "../snippetTest.pkl"

import "pkl:syntax"
import "pkl:test"

local parser = new syntax.Parser {}

local renderer = new syntax.FormattingRenderer {}

local function mod(source: String): syntax.GenericNode = parser.parseModule(source)

local function intLiteral(value: Int): syntax.GenericNode =
  new syntax.GenericNode {
    type = "int_literal_expr"
    text = value.toString()
  }

local sample: syntax.GenericNode =
  mod("""
    class Point {
      x: Int
      y: Int
    }

    origin = new Point { x = 0; y = 0 }
    """)

facts {
  ["findChild returns the first match in pre-order"] {
    sample.findChild((n) -> n.type == "identifier").text == "Point"
    sample.findChild((n) -> n.type == "int_literal_expr").text == "0"
  }

  ["findChild throws when nothing matches"] {
    test.catch(() -> sample.findChild((n) -> n.type == "when_generator"))
      .contains("Cannot find a child node matching the predicate")
  }

  ["findChildOrNull returns null when nothing matches"] {
    sample.findChildOrNull((n) -> n.type == "when_generator") == null
    sample.findChildOrNull((n) -> n.type == "identifier")!!.text == "Point"
  }

  ["findChild does not consider this node"] {
    sample.findChildOrNull((n) -> n.type == "module") == null
    sample.type == "module"
  }

  ["findChildren returns every match in pre-order"] {
    sample.findChildren((n) -> n.type == "identifier").map((n) -> n.text)
      == List("Point", "x", "Int", "y", "Int", "origin", "Point", "x", "y")

    sample.findChildren((n) -> n.type == "when_generator") == List()
  }

  ["findChildren searches a match for further matches"] {
    // the outer object body contains the two entries, which are themselves matches
    mod("foo { bar { baz = 1 } }").findChildren((n) -> n.type == "object_body").length == 2
  }

  ["findChildOfType agrees with findChild"] {
    sample.findChildOfType("class").text == sample.findChild((n) -> n.type == "class").text
    sample.findChildrenOfType("identifier").length == 9
  }

  ["findChildOfType throws when nothing matches"] {
    test.catch(() -> sample.findChildOfType("when_generator"))
      .contains("Cannot find a child node of type `when_generator`")
  }

  ["findChildOfTypeOrNull returns null when nothing matches"] {
    sample.findChildOfTypeOrNull("when_generator") == null
    sample.findChildOfTypeOrNull("class")!!.text == sample.findChildOfType("class").text
  }

  ["findParent returns the nearest match"] {
    local inner = mod("foo { bar { baz = 1 } }").findChild((n) -> n.text == "baz")
    inner.findParent((n) -> n.type == "object_body").text == "{ baz = 1 }"
    inner.findParent((n) -> n.type == "module").type == "module"
    test.catch(() -> inner.findParent((n) -> n.type == "class"))
      .contains("Cannot find a parent node matching the predicate")
  }

  ["findParentOrNull returns null when nothing matches"] {
    local inner = mod("foo { bar { baz = 1 } }").findChild((n) -> n.text == "baz")
    inner.findParentOrNull((n) -> n.type == "class") == null
    inner.findParentOrNull((n) -> n.type == "object_body")!!.text == "{ baz = 1 }"
  }

  ["findParentOfType agrees with findParent"] {
    local inner = mod("foo { bar { baz = 1 } }").findChild((n) -> n.text == "baz")
    inner.findParentOfType("object_body").text == "{ baz = 1 }"
    test.catch(() -> inner.findParentOfType("class"))
      .contains("Cannot find a parent node of type `class`")
  }

  ["findParentOfTypeOrNull returns null when nothing matches"] {
    local inner = mod("foo { bar { baz = 1 } }").findChild((n) -> n.text == "baz")
    inner.findParentOfTypeOrNull("class") == null
    inner.findParentOfTypeOrNull("object_body")!!.text == "{ baz = 1 }"
  }

  ["findParents returns every match, nearest first"] {
    local inner = mod("foo { bar { baz = 1 } }").findChild((n) -> n.text == "baz")
    inner.findParents((n) -> n.type == "object_body").map((n) -> n.text)
      == List("{ baz = 1 }", "{ bar { baz = 1 } }")
  }

  ["parent lookups do not consider this node"] {
    sample.findParentOrNull((n) -> n.type == "module") == null
    sample.findParents((n) -> true) == List()
    !sample.hasParentOfType("module")
  }

  ["hasParent and hasParentOfType follow findParent"] {
    local inner = mod("foo { bar = 1 }").findChild((n) -> n.text == "bar")
    inner.hasParent((n) -> n.type == "object_body")
    inner.hasParentOfType("class_property")
    !inner.hasParentOfType("class")
  }

  ["replaceChild replaces only the first match"] {
    renderer.render(
      mod("x = 1 + 1").replaceChild((n) -> n.type == "int_literal_expr", (_n) -> intLiteral(9))
    ) == "x = 9 + 1\n"
  }

  ["replaceChild leaves the tree unchanged when nothing matches"] {
    renderer.render(
      mod("x = 1").replaceChild((n) -> n.type == "when_generator", (_n) -> intLiteral(9))
    ) == "x = 1\n"
  }

  ["replaceChildren replaces every match"] {
    renderer.render(
      mod("x = 1 + 1").replaceChildren((n) -> n.type == "int_literal_expr", (_n) -> intLiteral(9))
    ) == "x = 9 + 9\n"
  }

  ["a replacer sees the node it replaces"] {
    renderer.render(
      mod("x = 1 + 2").replaceChildren(
        (n) -> n.type == "int_literal_expr",
        (n) -> intLiteral(n.text!!.toInt() * 10),
      )
    ) == "x = 10 + 20\n"
  }

  ["a replacement is not searched for further matches"] {
    // replacing an identifier with an identifier terminates instead of looping
    renderer.render(
      mod("foo = 1").replaceChildrenOfType("identifier", (n) -> (n) { text = "\(n.text!!)Bar" })
    ) == "fooBar = 1\n"
  }

  ["replaceChildOfType agrees with replaceChild"] {
    renderer.render(mod("x = 1 + 1").replaceChildOfType("int_literal_expr", (_n) -> intLiteral(9)))
      == renderer.render(
        mod("x = 1 + 1").replaceChild((n) -> n.type == "int_literal_expr", (_n) -> intLiteral(9))
      )
  }

  ["a replacer sees where its node sits in the tree being built"] {
    local result =
      mod("x = 1").replaceChildOfType("int_literal_expr", (n) ->
        if (n.hasParentOfType("class_property")) intLiteral(9) else intLiteral(0))
    renderer.render(result) == "x = 9\n"
  }

  ["a replace does not change the tree it walks"] {
    local original = mod("x = 1")
    local rewritten = original.replaceChildrenOfType("int_literal_expr", (_n) -> intLiteral(9))
    let (rendered = renderer.render(rewritten))
      rendered == "x = 9\n" && renderer.render(original) == "x = 1\n"
  }

  ["the root of a replaced tree has no parent"] {
    mod("x = 1").replaceChildrenOfType("int_literal_expr", (_n) -> intLiteral(9)).parent == null
    mod("x = 1").replaceChildrenOfType("when_generator", (_n) -> intLiteral(9)).parent == null
  }

  ["only the root of a replaced tree has no parent"] {
    mod("x = 1")
      .replaceChildrenOfType("int_literal_expr", (_n) -> intLiteral(9))
      .fold(0, (acc, n) -> if (n.parent == null) acc + 1 else acc) == 1
  }
}
