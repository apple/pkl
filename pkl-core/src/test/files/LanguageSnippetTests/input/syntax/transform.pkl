amends "../snippetTest.pkl"

import "pkl:syntax"

local parser = new syntax.Parser {}

local function mod(source: String): syntax.GenericNode = parser.parseModule(source)

local renderer = new syntax.Renderer {}

local function fmt(source: String): String = renderer.render(mod(source))

local function transformFormat(
  source: String,
  operator: (syntax.GenericNode) -> Pair<syntax.GenericNode, Boolean>,
): String = renderer.render(mod(source).transform(operator))

local function intLiteral(value: Int): syntax.GenericNode =
  new syntax.GenericNode {
    type = "int_literal_expr"
    text = value.toString()
  }

facts {
  ["read-only transform leaves the tree unchanged"] {
    // returning the node itself everywhere keeps every node and keeps descending
    transformFormat("x = 1", (n) -> Pair(n, true)) == fmt("x = 1")
    transformFormat("x = if (cond) 1 else 2", (n) -> Pair(n, true))
      == fmt("x = if (cond) 1 else 2")
  }

  ["rename identifiers everywhere"] {
    transformFormat("foo = foo + 1", (n) ->
      if (n.type == "identifier" && n.text == "foo")
        Pair((n) { text = "bar" }, true)
      else
        Pair(n, true)
    ) == fmt("bar = bar + 1")
  }

  ["replace a leaf with a constructed node"] {
    transformFormat("x = 0", (n) ->
      if (n.type == "int_literal_expr" && n.text == "0")
        Pair(intLiteral(100), false)
      else
        Pair(n, true)
    ) == fmt("x = 100")
  }

  ["rebuilds ancestors of a changed node"] {
    transformFormat("x = if (cond) 41 else 0", (n) ->
      if (n.type == "int_literal_expr" && n.text == "41")
        Pair(intLiteral(42), false)
      else if (n.type == "int_literal_expr" && n.text == "0")
        Pair(intLiteral(100), false)
      else
        Pair(n, true)
    ) == fmt("x = if (cond) 42 else 100")
  }

  ["splice in a parsed subtree"] {
    transformFormat("x = 0", (n) ->
      if (n.type == "int_literal_expr")
        Pair(parser.parseExpression("foo.bar + 1"), false)
      else
        Pair(n, true)
    ) == fmt("x = foo.bar + 1")
  }

  ["descend reprocesses emitted nodes"] {
    transformFormat("x = 0", (n) ->
      if (n.type == "int_literal_expr" && n.text == "0")
        Pair(parser.parseExpression("(1)"), true)
      else if (n.type == "int_literal_expr" && n.text == "1")
        Pair(intLiteral(2), true)
      else
        Pair(n, true)
    ) == fmt("x = (2)")
  }

  ["descend = false leaves the emitted subtree untouched"] {
    transformFormat("x = 0", (n) ->
      if (n.type == "int_literal_expr" && n.text == "0")
        Pair(parser.parseExpression("(1)"), false)
      else if (n.type == "int_literal_expr" && n.text == "1")
        Pair(intLiteral(2), true)
      else
        Pair(n, true)
    ) == fmt("x = (1)")
  }
}
