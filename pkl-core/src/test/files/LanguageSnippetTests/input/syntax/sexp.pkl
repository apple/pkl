amends "../snippetTest.pkl"

import "pkl:syntax"
import "pkl:test"

local renderer = new syntax.SExpressionRenderer {}
local textRenderer = new syntax.SExpressionRenderer { renderTerminalText = true }

local function parseExpr(source: String): syntax.Node =
  new syntax.Parser {}.parseExpression(source)

local function parseModule(source: String): syntax.Node =
  new syntax.Parser {}.parseModule(source)

facts {
  ["terminal"] {
    renderer.renderValue(parseExpr("5")) == "(int_literal_expr)"
  }

  ["terminal with text"] {
    textRenderer.renderValue(parseExpr("5")) == #"(int_literal_expr "5")"#
  }

  ["nested nodes are indented"] {
    renderer.renderValue(parseExpr("1 + 2"))
      == """
      (binary_op_expr
        (int_literal_expr)
        (operator)
        (int_literal_expr))
      """
  }

  ["nested nodes with terminal text"] {
    textRenderer.renderValue(parseExpr("1 + 2"))
      == #"""
      (binary_op_expr
        (int_literal_expr "1")
        (operator "+")
        (int_literal_expr "2"))
      """#
  }

  ["keywords and punctuation are rendered without text"] {
    textRenderer.renderValue(parseExpr("if (true) x else 0"))
      == #"""
      (if_expr
        (if_header
          (if_keyword)
          (if_condition
            (lparen)
            (if_condition_expr
              (bool_literal_expr "true"))
            (rparen)))
        (if_then_expr
          (unqualified_access_expr
            (identifier "x")))
        (else_keyword)
        (if_else_expr
          (int_literal_expr "0")))
      """#
  }

  ["terminal text is escaped"] {
    textRenderer.renderValue(parseExpr(#""a \"b\"\n""#))
      == #"""
      (single_line_string_literal_expr
        (string_start "\"")
        (string_chars "a ")
        (string_escape "\\\"")
        (string_chars "b")
        (string_escape "\\\"")
        (string_escape "\\n")
        (string_end "\""))
      """#
  }

  ["renderDocument adds a trailing newline"] {
    renderer.renderDocument(parseExpr("5")) == "(int_literal_expr)\n"
  }

  ["rendering a non-node throws"] {
    test.catch(() -> renderer.renderValue(5)).contains("Expected a `pkl.syntax#Node`")
  }
}

examples {
  ["module"] {
    renderer.renderValue(parseModule("x = 1"))
    textRenderer.renderValue(parseModule("x = 1"))
  }

  ["class"] {
    renderer.renderValue(
      parseModule(
        """
        class Bird {
          name: String
        }
        """,
      )
    )
  }
}
