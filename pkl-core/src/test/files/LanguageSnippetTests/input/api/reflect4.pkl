amends ".../snippetTest.pkl"

import "pkl:reflect"

local class MyAnn extends Annotation

open local class A {
  inheritedFromA: String
  open overriddenInBFromA: String
  open overriddenInCFromA: String
  open overriddenInBCFromA: String

  fixed modA: String = ""
  open fixed modAOverrideB: String = ""
  open fixed modAOverrideC: String = ""
  open fixed modAOverrideBC: String = ""
  open fixed modAOverrideCB: String = ""

  @Unlisted
  annA: String
  @Unlisted
  open annAOverrideB: String
  @Unlisted
  open annAOverrideC: String
  @Unlisted
  open annAOverrideBC: String
}

open local class B extends A {
  inheritedFromB: String
  override overriddenInBFromA: Int
  open  overriddenInCFromB: String
  override overriddenInBCFromA: Int

  fixed modB: String = ""
  override hidden fixed modAOverrideB: Int = 0
  override hidden fixed modAOverrideBC: Int = 0
  override fixed modAOverrideCB: Int = 0

  @Unlisted
  annB: String
  @MyAnn
  override annAOverrideB: String
  @MyAnn
  override annAOverrideBC: String
}

local class C extends B {
  fromC: String
  override overriddenInCFromA: Int
  override overriddenInCFromB: Int
  override overriddenInBCFromA: Boolean

  fixed modC: String = ""
  override hidden fixed modAOverrideC: Int = 0
  override fixed modAOverrideBC: Boolean = false
  override hidden fixed modAOverrideCB: Boolean = false

  @Unlisted
  annC: String
  @MyAnn
  override annAOverrideC: String
  @AlsoKnownAs { names { "mergedAnnotations" } }
  override annAOverrideBC: String
}

local class DisplayProperty {
  hidden property: reflect.Property
  fixed name = property.name
  fixed annotations = property.annotations.map((it) -> it.toString()).toListing()
  fixed allAnnotations = property.allAnnotations.map((it) -> it.toString()).toListing()
  fixed modifiers = property.modifiers.toListing()
  fixed allModifiers = property.allModifiers.toListing()
  fixed type = property.type.getPropertyOrNull("referent")?.getPropertyOrNull("name") ?? "unknown"
}

examples {
  ["C"] {
    reflect.Class(C).allProperties.mapValues((_, it) -> new DisplayProperty { property = it }).toMapping()
  }
  ["module"] {
    new DisplayProperty { property = reflect.Class(module.getClass()).properties["output"] }
  }
}

output { // override to test example "module", allModifiers should contain "hidden"
  text = super.text + "\n// hello world"
}
